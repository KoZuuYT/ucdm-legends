{
  "title": "UCDM Legends",
  "display": {
    "width": 1280,
    "height": 720,
    "fullscreen": false,
    "vsync": true,
    "tick_rate": 60,
    "fps_cap": 144,
    "show_fps": false
  },
  "input": {
    "left": [
      "left",
      "a"
    ],
    "right": [
      "right",
      "d"
    ],
    "up": [
      "up",
      "w"
    ],
    "down": [
      "down",
      "s"
    ],
    "confirm": [
      "return",
      "space"
    ],
    "back": [
      "escape",
      "backspace"
    ],
    "attack": [
      "mouse1",
      "j"
    ],
    "block": [
      "f",
      "k"
    ],
    "dodge": [
      "left shift",
      "l"
    ]
  },
  "audio": {
    "sfx_volume": 0.8,
    "music_volume": 0.5,
    "sfx": {
      "back": [
        "audio/sfx/back1.wav",
        "audio/sfx/back2.wav",
        "audio/sfx/back3.wav"
      ],
      "block": [
        "audio/sfx/block1.wav",
        "audio/sfx/block2.wav",
        "audio/sfx/block3.wav"
      ],
      "click": [
        "audio/sfx/click1.wav",
        "audio/sfx/click2.wav",
        "audio/sfx/click3.wav"
      ],
      "coin": [
        "audio/sfx/coin1.wav",
        "audio/sfx/coin2.wav",
        "audio/sfx/coin3.wav"
      ],
      "confirm": [
        "audio/sfx/confirm1.wav",
        "audio/sfx/confirm2.wav",
        "audio/sfx/confirm3.wav"
      ],
      "crit": [
        "audio/sfx/crit1.wav",
        "audio/sfx/crit2.wav",
        "audio/sfx/crit3.wav"
      ],
      "hit": [
        "audio/sfx/hit1.wav",
        "audio/sfx/hit2.wav",
        "audio/sfx/hit3.wav"
      ],
      "hover": [
        "audio/sfx/hover1.wav",
        "audio/sfx/hover2.wav",
        "audio/sfx/hover3.wav"
      ],
      "ko": [
        "audio/sfx/ko1.wav",
        "audio/sfx/ko2.wav",
        "audio/sfx/ko3.wav"
      ],
      "levelup": [
        "audio/sfx/levelup1.wav",
        "audio/sfx/levelup2.wav",
        "audio/sfx/levelup3.wav"
      ],
      "miss": [
        "audio/sfx/miss1.wav",
        "audio/sfx/miss2.wav",
        "audio/sfx/miss3.wav"
      ],
      "parry": [
        "audio/sfx/parry1.wav",
        "audio/sfx/parry2.wav",
        "audio/sfx/parry3.wav"
      ],
      "pause": [
        "audio/sfx/pause1.wav",
        "audio/sfx/pause2.wav",
        "audio/sfx/pause3.wav"
      ],
      "save": "audio/sfx/save.wav",
      "warning": "audio/sfx/warning.wav",
      "whoosh": [
        "audio/sfx/whoosh1.wav",
        "audio/sfx/whoosh2.wav",
        "audio/sfx/whoosh3.wav"
      ]
    },
    "music": {
      "menu": "audio/music/menu.wav",
      "hub": "audio/music/hub.wav",
      "training": "audio/music/training.wav",
      "arena": "audio/music/arena.wav"
    },
    "mute_on_focus_loss": false
  },
  "update": {
    "enabled": true,
    "repo": "KoZuuYT/ucdm-legends",
    "branch": "main",
    "asset_pattern": "UCDM-{platform}-v{version}.zip",
    "timeout": 6,
    "background_check": true,
    "background_minutes": 30
  },
  "default_character": "steve",
  "gameplay": {
    "difficulty": "normal",
    "extended_warning": false,
    "auto_pause": true,
    "battle_intro": true
  },
  "feedback": {},
  "language": "pt-BR",
  "accessibility": {
    "text_scale": 1.0,
    "colorblind": false,
    "high_contrast": false
  },
  "performance": {
    "low_mode": false
  }
}